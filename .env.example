# Copy to .env and fill in (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Set to 'true' ONLY after deploying the send-confirmation Edge Function.
# While 'false'/unset, booking skips the invoke entirely (no CORS noise).
VITE_NOTIFY_ENABLED=false
